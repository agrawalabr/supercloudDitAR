import torch
import time

def burn_gpu_heavy(device, gpu_idx, print_every=10):
    print(f"Starting heavy GPU load on device: {device}")
    size = 8192  # Significantly larger to ensure heavy load
    n_streams = 4  # Use multiple CUDA streams for more load
    streams = [torch.cuda.Stream(device=device) for _ in range(n_streams)]

    # Larger tensors for heavier matrix multiplication
    matrices = [
        (torch.randn(size, size, device=device), torch.randn(size, size, device=device))
        for _ in range(n_streams)
    ]

    i = 0
    try:
        while True:
            torch.cuda.synchronize(device)
            for sidx, stream in enumerate(streams):
                with torch.cuda.stream(stream):
                    x, y = matrices[sidx]
                    z = torch.mm(x, y)
                    # Use result for further nontrivial computation
                    z = torch.inverse(z + torch.eye(size, device=device) * 1e-3)
                    x = torch.relu(z)
                    matrices[sidx] = (x, y)
            torch.cuda.synchronize(device)
            i += 1
            if i % print_every == 0:
                allocated = torch.cuda.memory_allocated(device) / 1024**3
                reserved = torch.cuda.memory_reserved(device) / 1024**3
                print(f"[Device {gpu_idx}] Heavy load... iter: {i}, mem: {allocated:.2f}G (res {reserved:.2f}G)")
    except KeyboardInterrupt:
        print(f"\nStopped heavy GPU load on device: {device}")

if torch.cuda.is_available():
    n_gpus = torch.cuda.device_count()
    print(f"Detected {n_gpus} GPUs. Applying heavy load.")

    import threading
    threads = []
    for i in range(n_gpus):
        device = torch.device(f"cuda:{i}")
        t = threading.Thread(target=burn_gpu_heavy, args=(device, i))
        t.start()
        threads.append(t)
    try:
        for t in threads:
            t.join()
    except KeyboardInterrupt:
        print("\nAll heavy GPU load stopped by user.")
else:
    print("CUDA is NOT available. Running large matrix computations on CPU (single core, slow).")
    size = 8192
    x = torch.randn(size, size)
    y = torch.randn(size, size)
    try:
        i = 0
        while True:
            z = torch.mm(x, y)
            z = torch.inverse(z + torch.eye(size) * 1e-3)
            x = torch.relu(z)
            i += 1
            if i % 5 == 0:
                print(f"CPU burn iter {i}")
    except KeyboardInterrupt:
        print("\nCPU burn stopped by user.")
